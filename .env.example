# ==============================================================================
# Approval Management System (AMS) — Environment Configuration Template
# Copy this file to '.env' and fill in your keys as needed.
# NOTE: None of these are strictly required; the app works 100% offline with
# zero external dependencies using SQLite and the built-in local NLP parser!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDER API KEYS (Optional)
# Enter whichever key you want to use for the AI Chat & NLP Assistant.
# Leave blank to use the built-in free local offline NLP parser.
# ------------------------------------------------------------------------------
# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=

# Groq (https://console.groq.com/)
GROQ_API_KEY=

# Universal LLM fallback & configuration
AMS_LLM_API_KEY=
AMS_LLM_PROVIDER=auto
AMS_LLM_MODEL=
AMS_LLM_BASE_URL=

# ------------------------------------------------------------------------------
# 2. SUPABASE CLOUD STORAGE (Optional)
# If you want to store attachments in Supabase Storage instead of local disk.
# Leave blank to use zero-cost local disk storage in 'data/uploads/'.
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=approval-attachments

# ------------------------------------------------------------------------------
# 3. SERVER & SECURITY (Optional defaults are pre-configured)
# ------------------------------------------------------------------------------
PORT=5050
AMS_SECRET_KEY=dev-local-approval-mgmt-secret-change-in-prod
AMS_DB_PATH=data/approval_system.db
AMS_UPLOAD_DIR=data/uploads
AMS_LOG_DIR=logs
AMS_AI_RETRAIN_THRESHOLD=10
